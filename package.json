{
  "name": "aether-os",
  "version": "0.1.3",
  "description": "A permission-aware AI desktop workspace for macOS",
  "main": "electron/main.cjs",
  "author": "AETHER",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "preview": "node scripts/preview.cjs",
    "test": "node --test tests/*.test.cjs",
    "build:native": "bash scripts/build-native.sh",
    "dist:mac": "npm run build:native && electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.3"
  },
  "build": {
    "appId": "ai.aether.desktop",
    "productName": "AETHER",
    "files": [
      "electron/**/*",
      "ui/**/*"
    ],
    "extraResources": [
      {
        "from": "native/bin/aether-metrics",
        "to": "aether-metrics"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true
    },
    "dmg": {
      "title": "AETHER"
    }
  }
}
